{
  "name": "football-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "data:fetch": "git clone --depth 1 https://github.com/federicopaschetta/FootballPlayersAnalysis.git temp_data && mv temp_data/male_players.csv ./male_players.csv && rm -rf temp_data",
    "data:generate": "node scripts/generateGameData.cjs",
    "data:pipeline": "npm run data:fetch && npm run data:generate"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "csv-parser": "^3.2.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
